<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Pondhawk.Monaco</PackageId>
    <Authors>Pond Hawk Technologies Inc.</Authors>
    <Copyright>Copyright (c) 2026 Pond Hawk Technologies Inc.</Copyright>
    <Description>Blazor code editor wrapping Monaco with JSON-Schema-driven completion for YAML and JSON. Consumers need no JavaScript toolchain.</Description>
    <PackageTags>blazor;monaco;editor;yaml;json-schema</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/pondhawktech/pondhawk-monaco</PackageProjectUrl>

    <!--
      Required, not merely nice metadata: GitHub Packages resolves which repository owns a NuGet package
      from this URL, and rejects the push outright when it is absent.
    -->
    <RepositoryUrl>https://github.com/pondhawktech/pondhawk-monaco</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <!--
      This project's own README, not the one at the repo root. The root README is the design document —
      build pipeline, release process, why-not-BlazorMonaco — and none of that is what someone landing on
      the nuget.org listing needs. This one is usage only.
    -->
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The npm toolchain is repo-only, and must not be packaged. The Razor SDK globs **/*.json as Content,
      so without this the package ships js/package.json and js/package-lock.json as contentFiles — npm
      manifests dropped into consuming projects whose whole reason for taking this package is not having
      a JavaScript toolchain. The files stay on disk for the bundle step; they just stop being items.
    -->
    <Content Remove="js/**" />
    <None Remove="js/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.9" />
  </ItemGroup>

  <!--
    wwwroot/dist is a build artifact and is deliberately NOT in source control, so the build must be able
    to regenerate it — otherwise a fresh clone produces a package with no JavaScript in it, and the
    failure only shows up at runtime in the consuming app.

    Inputs/Outputs give MSBuild incremental behaviour: the (slow) bundle re-runs only when the JS sources
    change. Set SkipJsBundle=true to bypass it in environments without node.
  -->
  <Target Name="BundleJs"
          BeforeTargets="BeforeBuild"
          Condition="'$(SkipJsBundle)' != 'true'"
          Inputs="js/code-editor.js;js/build.mjs;js/package.json"
          Outputs="wwwroot/dist/code-editor.js">
    <Message Importance="high" Text="Bundling Monaco + monaco-yaml -> wwwroot/dist" />
    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="js" Condition="!Exists('js/node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="js" />
  </Target>

  <!--
    The bundle is produced during THIS build, so it is not yet known to the static-web-assets machinery
    when items are first evaluated. Re-globbing after bundling is what gets dist/ into the package as
    _content/Pondhawk.Monaco/dist/.
  -->
  <Target Name="IncludeBundledAssets" AfterTargets="BundleJs" BeforeTargets="ResolveStaticWebAssetsInputs">
    <ItemGroup>
      <Content Include="wwwroot/dist/**" Exclude="@(Content)" />
    </ItemGroup>
  </Target>

</Project>
