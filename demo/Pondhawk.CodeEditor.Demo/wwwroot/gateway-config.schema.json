{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pondhawk.tech/schemas/gateway-config.schema.json",
  "title": "Pondhawk Gateway Configuration",
  "type": "object",
  "properties": {
    "ContractsVersion": {
      "type": "string"
    },
    "Edge": {
      "type": "object",
      "properties": {
        "Mode": {
          "enum": [
            "CoLocated",
            "Standalone"
          ]
        },
        "ExternalScheme": {
          "type": "string"
        },
        "AlbAuth": {
          "type": "object",
          "properties": {
            "Enabled": {
              "type": "boolean"
            },
            "HeaderName": {
              "type": "string"
            },
            "Secret": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "From": {
                  "type": "string"
                }
              },
              "required": [
                "From"
              ]
            }
          }
        },
        "KnownProxies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "Replicas": {
          "type": "integer"
        },
        "DistributedStore": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "ConnectionString": {
              "type": "object",
              "properties": {
                "From": {
                  "type": "string"
                }
              },
              "required": [
                "From"
              ]
            }
          },
          "required": [
            "ConnectionString"
          ]
        }
      }
    },
    "Signing": {
      "type": "object",
      "properties": {
        "Key": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "From": {
              "type": "string"
            }
          },
          "required": [
            "From"
          ]
        },
        "PublicationUrl": {
          "type": "string"
        },
        "Issuer": {
          "type": "string"
        },
        "TokenTtl": {
          "$comment": "Represents a System.TimeSpan value.",
          "type": "string",
          "pattern": "^-?(\\d\u002B\\.)?\\d{2}:\\d{2}:\\d{2}(\\.\\d{1,7})?$"
        }
      }
    },
    "Session": {
      "type": "object",
      "properties": {
        "IdleTimeout": {
          "$comment": "Represents a System.TimeSpan value.",
          "type": "string",
          "pattern": "^-?(\\d\u002B\\.)?\\d{2}:\\d{2}:\\d{2}(\\.\\d{1,7})?$"
        },
        "AbsoluteLifetime": {
          "$comment": "Represents a System.TimeSpan value.",
          "type": "string",
          "pattern": "^-?(\\d\u002B\\.)?\\d{2}:\\d{2}:\\d{2}(\\.\\d{1,7})?$"
        },
        "SessionCookie": {
          "type": "object",
          "properties": {
            "Name": {
              "type": "string"
            },
            "SameSite": {
              "enum": [
                "Strict",
                "Lax",
                "None"
              ]
            },
            "HttpOnly": {
              "type": "boolean"
            },
            "Secure": {
              "type": "boolean"
            }
          },
          "required": [
            "Name"
          ]
        },
        "PreAuthCookie": {
          "type": "object",
          "properties": {
            "Name": {
              "type": "string"
            },
            "SameSite": {
              "enum": [
                "Strict",
                "Lax",
                "None"
              ]
            },
            "HttpOnly": {
              "type": "boolean"
            },
            "Secure": {
              "type": "boolean"
            }
          },
          "required": [
            "Name"
          ]
        },
        "AntiCsrfToken": {
          "type": "boolean"
        },
        "ForbidStateChangingGet": {
          "type": "boolean"
        },
        "RefreshRotation": {
          "type": "boolean"
        }
      }
    },
    "Observability": {
      "type": "object",
      "properties": {
        "WatchDomain": {
          "type": "string"
        },
        "MintCorrelationAtEdge": {
          "type": "boolean"
        }
      }
    },
    "IdpProfiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "Issuer": {
            "type": "string"
          },
          "Hosts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "IssuerValidation": {
            "enum": [
              "Exact",
              "EntraV1",
              "EntraV2",
              "MultiTenant"
            ]
          },
          "TenantAllowlist": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "Audience": {
            "enum": [
              "AudClaim",
              "ClientIdAndTokenUse"
            ]
          },
          "ValidAudiences": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ClientId": {
            "type": [
              "string",
              "null"
            ]
          },
          "RequireTokenUseAccess": {
            "type": "boolean"
          },
          "Algorithms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "DynamicClientRegistration": {
            "type": "boolean"
          },
          "Jwks": {
            "type": "object",
            "properties": {
              "Ttl": {
                "$comment": "Represents a System.TimeSpan value.",
                "type": "string",
                "pattern": "^-?(\\d\u002B\\.)?\\d{2}:\\d{2}:\\d{2}(\\.\\d{1,7})?$"
              },
              "RefreshInterval": {
                "$comment": "Represents a System.TimeSpan value.",
                "type": "string",
                "pattern": "^-?(\\d\u002B\\.)?\\d{2}:\\d{2}:\\d{2}(\\.\\d{1,7})?$"
              },
              "UnknownKidNegativeCache": {
                "$comment": "Represents a System.TimeSpan value.",
                "type": "string",
                "pattern": "^-?(\\d\u002B\\.)?\\d{2}:\\d{2}:\\d{2}(\\.\\d{1,7})?$"
              }
            }
          },
          "Claims": {
            "type": "object",
            "properties": {
              "Roles": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "Scopes": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "Tenant": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "Username": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "FirstName": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "LastName": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "Email": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "Groups": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "RoleValueMap": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          },
          "DiscoveryUri": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          }
        },
        "required": [
          "Issuer"
        ]
      }
    },
    "AuthorizationPolicies": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "Require": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "Kind": {
                  "enum": [
                    "Scope",
                    "Role",
                    "Claim"
                  ]
                },
                "Claim": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "Mode": {
                  "enum": [
                    "Any",
                    "All"
                  ]
                },
                "Values": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "Values"
              ]
            }
          }
        }
      }
    },
    "RateLimitPolicies": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "Algorithm": {
            "enum": [
              "TokenBucket",
              "SlidingWindow",
              "FixedWindow",
              "Concurrency"
            ]
          },
          "Partition": {
            "enum": [
              "Sub",
              "Client",
              "Ip"
            ]
          },
          "PermitLimit": {
            "type": "integer"
          },
          "TokensPerPeriod": {
            "type": "integer"
          },
          "Period": {
            "$comment": "Represents a System.TimeSpan value.",
            "type": "string",
            "pattern": "^-?(\\d\u002B\\.)?\\d{2}:\\d{2}:\\d{2}(\\.\\d{1,7})?$"
          },
          "QueueLimit": {
            "type": "integer"
          },
          "FailMode": {
            "enum": [
              "DegradeToLocal",
              "Conservative"
            ]
          }
        }
      }
    },
    "CorsPolicies": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "Enabled": {
            "type": "boolean"
          },
          "AllowedOrigins": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "AllowCredentials": {
            "type": "boolean"
          },
          "AllowedMethods": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "AllowedHeaders": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ExposedHeaders": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "PreflightMaxAge": {
            "$comment": "Represents a System.TimeSpan value.",
            "type": "string",
            "pattern": "^-?(\\d\u002B\\.)?\\d{2}:\\d{2}:\\d{2}(\\.\\d{1,7})?$"
          }
        }
      }
    },
    "SecurityHeaderPolicies": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "IsHtmlResponse": {
            "type": "boolean"
          },
          "Csp": {
            "enum": [
              "Gateway",
              "Backend",
              "Off"
            ]
          },
          "CspDirectives": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "Hsts": {
            "type": "boolean"
          },
          "Coop": {
            "type": "boolean"
          },
          "ReferrerPolicy": {
            "type": "string"
          },
          "PermissionsPolicy": {
            "type": [
              "string",
              "null"
            ]
          },
          "ReportOnly": {
            "type": "boolean"
          },
          "EnforceBy": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "NoStore": {
            "type": "boolean"
          }
        }
      }
    },
    "StreamingProfiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "Kind": {
            "enum": [
              "Sse",
              "WebSocket"
            ]
          },
          "NoBuffering": {
            "type": "boolean"
          },
          "ActivityTimeout": {
            "$comment": "Represents a System.TimeSpan value.",
            "type": "string",
            "pattern": "^-?(\\d\u002B\\.)?\\d{2}:\\d{2}:\\d{2}(\\.\\d{1,7})?$"
          },
          "IdleTimeout": {
            "$comment": "Represents a System.TimeSpan value.",
            "type": "string",
            "pattern": "^-?(\\d\u002B\\.)?\\d{2}:\\d{2}:\\d{2}(\\.\\d{1,7})?$"
          },
          "MaxConnectionLifetime": {
            "$comment": "Represents a System.TimeSpan value.",
            "type": "string",
            "pattern": "^-?(\\d\u002B\\.)?\\d{2}:\\d{2}:\\d{2}(\\.\\d{1,7})?$"
          },
          "PerInstanceConnectionCap": {
            "type": "integer"
          },
          "PerPrincipalConnectionCap": {
            "type": "integer"
          },
          "WebSocketOriginAllowlist": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "SseReauthInterval": {
            "$comment": "Represents a System.TimeSpan value.",
            "type": [
              "string",
              "null"
            ],
            "pattern": "^-?(\\d\u002B\\.)?\\d{2}:\\d{2}:\\d{2}(\\.\\d{1,7})?$"
          },
          "BindMcpSessionToPrincipal": {
            "type": "boolean"
          },
          "McpReplayBufferLimit": {
            "type": "integer"
          }
        }
      }
    },
    "Defaults": {
      "type": "object",
      "properties": {
        "RateLimitPolicy": {
          "type": [
            "string",
            "null"
          ]
        },
        "SecurityHeaderPolicy": {
          "type": [
            "string",
            "null"
          ]
        },
        "CorsPolicy": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Routes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string"
          },
          "Match": {
            "type": "object",
            "properties": {
              "Path": {
                "type": "string"
              },
              "Hosts": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string"
                }
              },
              "Methods": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "Path"
            ]
          },
          "Order": {
            "type": [
              "integer",
              "null"
            ]
          },
          "Upstream": {
            "type": "object",
            "properties": {
              "Destination": {
                "type": "string"
              },
              "Timeout": {
                "$comment": "Represents a System.TimeSpan value.",
                "type": "string",
                "pattern": "^-?(\\d\u002B\\.)?\\d{2}:\\d{2}:\\d{2}(\\.\\d{1,7})?$"
              }
            },
            "required": [
              "Destination"
            ]
          },
          "Auth": {
            "enum": [
              "Bff",
              "Bearer",
              "Anonymous"
            ]
          },
          "AcceptedIdps": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "AuthorizationPolicy": {
            "type": [
              "string",
              "null"
            ]
          },
          "RateLimitPolicy": {
            "type": [
              "string",
              "null"
            ]
          },
          "CorsPolicy": {
            "type": [
              "string",
              "null"
            ]
          },
          "SecurityHeaderPolicy": {
            "type": [
              "string",
              "null"
            ]
          },
          "StreamingProfile": {
            "type": [
              "string",
              "null"
            ]
          },
          "Transforms": {
            "type": "object",
            "properties": {
              "PathRemovePrefix": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "PathSet": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "AddRequestHeaders": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": {
                  "type": "string"
                }
              },
              "RemoveRequestHeaders": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string"
                }
              },
              "ForwardHeaderAllowlist": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string"
                }
              },
              "StripBackendFingerprintHeaders": {
                "type": "boolean"
              }
            }
          }
        },
        "required": [
          "Id",
          "Match",
          "Upstream"
        ]
      }
    }
  },
  "required": [
    "ContractsVersion"
  ]
}