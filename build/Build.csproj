<Project Sdk="Microsoft.NET.Sdk">

  <!-- Cake Frosting build. Run via ./build.sh (which invokes: dotnet run then a target argument). -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Cake.Frosting" Version="7.0.0" />
  </ItemGroup>

</Project>
